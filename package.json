{
  "name": "numerouno",
  "private": true,
  "type": "module",
  "scripts": {
    "generate": "node scripts/generate-wp-embed.mjs",
    "assemble": "node scripts/assemble-page.mjs",
    "build:local": "node scripts/build-local-preview.mjs",
    "package:local": "node scripts/package-local.mjs",
    "preview": "node scripts/build-local-preview.mjs && npx --yes serve dist/local-preview",
    "verify": "node scripts/generate-wp-embed.mjs && node scripts/verify-wp-embed.mjs",
    "verify:map": "node scripts/assemble-page.mjs && node scripts/verify-map-locked.mjs",
    "verify:ui": "node scripts/assemble-page.mjs && node scripts/verify-map-locked.mjs && node scripts/verify-step1.mjs",
    "verify:production": "node scripts/assemble-page.mjs && node scripts/verify-production.mjs",
    "compare:live": "node scripts/assemble-page.mjs && node scripts/compare-live-dom.mjs"
  },
